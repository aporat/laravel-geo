{
  "name": "aporat/laravel-geo",
  "description": "IP geolocation for Laravel: a MaxMind GeoLite2/GeoIP2 reader with an ordered driver chain (edge headers, local databases, HTTP providers), a typed Location, database updates from the terminal, and a fake for tests",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/aporat/laravel-geo",
  "keywords": [
    "laravel",
    "geoip",
    "geolocation",
    "maxmind",
    "geolite2",
    "ip",
    "location",
    "timezone"
  ],
  "authors": [
    {
      "name": "Adar Porat",
      "email": "aporat28@gmail.com",
      "homepage": "https://github.com/aporat",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-phar": "*",
    "ext-zlib": "*",
    "geoip2/geoip2": "^3.1",
    "laravel/framework": "^12.0 || ^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.21",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0 || ^13.0"
  },
  "suggest": {
    "ext-maxminddb": "MaxMind's C reader, a drop-in that makes every local database lookup many times faster (pie install maxmind-db/reader-ext)"
  },
  "autoload": {
    "psr-4": {
      "Aporat\\Geo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aporat\\Geo\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Aporat\\Geo\\GeoServiceProvider"
      ],
      "aliases": {
        "Geo": "Aporat\\Geo\\Facades\\Geo"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-ci": "vendor/bin/phpunit --coverage-text --coverage-clover coverage.xml --log-junit junit.xml",
    "check": "vendor/bin/pint --test",
    "fix": "vendor/bin/pint",
    "analyze": "vendor/bin/phpstan analyse --memory-limit=-1"
  },
  "support": {
    "issues": "https://github.com/aporat/laravel-geo/issues",
    "source": "https://github.com/aporat/laravel-geo"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
